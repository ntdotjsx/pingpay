---
import BaseHead from "../components/BaseHead.astro";
import { Footer } from "../components/Footer.tsx";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { HeroSection } from "@/components/hero";
import { LogosSection } from "@/components/logos-section";
import { FaqsSection } from "@/components/faqs-page";
---

<!doctype html>
<html lang="th">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sarabun:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        font-family: "Sarabun", sans-serif;
      }
    </style>
  </head>
  <body class="bg-[#F5F5F5] text-[#303841]">
    <Header />
    <HeroSection />
    <LogosSection client:load />
    <!-- ─────────────────────────────────────────
         FEATURE SECTION  (left list + tilted mockup)
    ───────────────────────────────────────── -->
    <section id="features">
      <div class="max-w-5xl mx-auto px-4 py-24">
        <div class="grid grid-cols-12 gap-x-16 gap-y-16 items-center">
          <!-- Feature list (left) -->
          <div class="col-span-12 lg:col-span-5">
            <p
              class="text-[11px] font-bold tracking-[0.14em] text-[#303841]/40 uppercase mb-4"
            >
              ฟีเจอร์หลัก
            </p>
            <h2
              class="text-3xl font-extrabold text-[#303841] leading-tight mb-3"
            >
              ทุกอย่างที่ต้องการ<br />อยู่ที่นี่ครบ
            </h2>
            <p class="text-[#303841]/50 text-sm leading-relaxed mb-12">
              ออกแบบมาให้ใช้งานง่ายสำหรับกลุ่มเพื่อน ไม่ต้องเรียนรู้นาน
              เปิดมาใช้ได้เลย
            </p>

            <div class="space-y-0 divide-y divide-[#303841]/8">
              <div class="py-6 group cursor-default">
                <div class="flex items-start gap-4">
                  <div
                    class="w-px h-full bg-[#FFF200] self-stretch shrink-0 w-[3px] rounded-full mt-1"
                  >
                  </div>
                  <div>
                    <h3 class="font-bold text-[#303841] mb-1">
                      บันทึกรายการยืมเงิน
                    </h3>
                    <p class="text-sm text-[#303841]/50 leading-relaxed">
                      ระบุชื่อ จำนวน เหตุผล วันครบกำหนด บันทึกได้ใน 10 วินาที
                      ทั้งกลุ่มเห็นทันที
                    </p>
                  </div>
                </div>
              </div>

              <div class="py-6 group cursor-default">
                <div class="flex items-start gap-4">
                  <div
                    class="w-px h-full bg-[#303841]/15 self-stretch shrink-0 w-[3px] rounded-full mt-1 group-hover:bg-[#FFF200] transition-colors"
                  >
                  </div>
                  <div>
                    <h3 class="font-bold text-[#303841] mb-1">
                      แจ้งเตือนอัตโนมัติ
                    </h3>
                    <p class="text-sm text-[#303841]/50 leading-relaxed">
                      ระบบส่ง notification ให้ผู้ยืมก่อนครบกำหนด
                      และเมื่อเกินกำหนด โดยไม่ต้องทวงเอง
                    </p>
                  </div>
                </div>
              </div>

              <div class="py-6 group cursor-default">
                <div class="flex items-start gap-4">
                  <div
                    class="w-px h-full bg-[#303841]/15 self-stretch shrink-0 w-[3px] rounded-full mt-1 group-hover:bg-[#FFF200] transition-colors"
                  >
                  </div>
                  <div>
                    <h3 class="font-bold text-[#303841] mb-1">
                      แดชบอร์ดยอดสุทธิ
                    </h3>
                    <p class="text-sm text-[#303841]/50 leading-relaxed">
                      เห็นภาพรวมทันทีว่าใครค้างใครเท่าไร
                      คำนวณยอดสุทธิให้อัตโนมัติ
                    </p>
                  </div>
                </div>
              </div>

              <div class="py-6 group cursor-default">
                <div class="flex items-start gap-4">
                  <div
                    class="w-px h-full bg-[#303841]/15 self-stretch shrink-0 w-[3px] rounded-full mt-1 group-hover:bg-[#FFF200] transition-colors"
                  >
                  </div>
                  <div>
                    <h3 class="font-bold text-[#303841] mb-1">
                      ยืนยันเคลียร์ทั้งสองฝ่าย
                    </h3>
                    <p class="text-sm text-[#303841]/50 leading-relaxed">
                      กดยืนยันรับเงิน รายการปิดสะอาด ทั้งกลุ่มเห็นว่าเคลียร์แล้ว
                      ไม่มีเถียงกัน
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tilted summary mockup (right) -->
          <div
            class="col-span-12 lg:col-span-7 relative flex justify-center items-center min-h-[460px]"
          >
            <div
              class="absolute inset-0 bg-gradient-to-br from-[#D6E6F2]/40 to-transparent rounded-3xl"
            >
            </div>

            <!-- main tilted card -->
            <div
              class="relative rotate-[3deg] shadow-2xl shadow-[#303841]/12 rounded-2xl border border-[#303841]/10 bg-white w-full max-w-[480px] overflow-hidden"
            >
              <!-- chrome -->
              <div class="bg-[#303841] px-4 py-2.5 flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-white/15"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-white/15"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-white/15"></span>
                <span class="ml-auto text-[10px] font-mono text-white/30"
                  >สรุปรายเดือน — พ.ค. 2025</span
                >
              </div>

              <div class="p-5 space-y-3">
                <!-- summary grid -->
                <div class="grid grid-cols-3 gap-3">
                  <div class="bg-[#F5F5F5] rounded-xl p-3.5">
                    <p class="text-[10px] text-[#303841]/40 mb-1">
                      รายการทั้งหมด
                    </p>
                    <p class="text-2xl font-extrabold text-[#303841]">12</p>
                  </div>
                  <div class="bg-[#FFF200]/30 rounded-xl p-3.5">
                    <p class="text-[10px] text-[#303841]/40 mb-1">ค้างอยู่</p>
                    <p class="text-2xl font-extrabold text-amber-700">4</p>
                  </div>
                  <div class="bg-emerald-50 rounded-xl p-3.5">
                    <p class="text-[10px] text-[#303841]/40 mb-1">
                      เคลียร์แล้ว
                    </p>
                    <p class="text-2xl font-extrabold text-emerald-600">8</p>
                  </div>
                </div>

                <!-- member breakdown -->
                <div class="bg-[#F5F5F5] rounded-xl overflow-hidden">
                  <div class="px-4 py-2.5 border-b border-[#303841]/8">
                    <p
                      class="text-[10px] font-bold tracking-widest text-[#303841]/40 uppercase"
                    >
                      ยอดแต่ละคน
                    </p>
                  </div>
                  <div class="divide-y divide-[#303841]/6">
                    <div class="flex items-center gap-3 px-4 py-3">
                      <div
                        class="w-7 h-7 rounded-full bg-[#D6E6F2] flex items-center justify-center text-[11px] font-bold shrink-0"
                      >
                        ก
                      </div>
                      <span class="flex-1 text-xs font-semibold text-[#303841]"
                        >ก้อง</span
                      >
                      <div class="flex items-center gap-2">
                        <div
                          class="h-1.5 bg-rose-200 rounded-full w-16 overflow-hidden"
                        >
                          <div
                            class="h-full bg-rose-500 rounded-full"
                            style="width:60%"
                          >
                          </div>
                        </div>
                        <span
                          class="text-xs font-bold text-rose-500 w-14 text-right"
                          >−฿340</span
                        >
                      </div>
                    </div>
                    <div
                      class="flex items-center gap-3 px-4 py-3 bg-rose-50/40"
                    >
                      <div
                        class="w-7 h-7 rounded-full bg-rose-100 flex items-center justify-center text-[11px] font-bold text-rose-600 shrink-0"
                      >
                        ต
                      </div>
                      <span class="flex-1 text-xs font-semibold text-[#303841]"
                        >ต้น</span
                      >
                      <div class="flex items-center gap-2">
                        <div
                          class="h-1.5 bg-rose-200 rounded-full w-16 overflow-hidden"
                        >
                          <div
                            class="h-full bg-rose-500 rounded-full"
                            style="width:100%"
                          >
                          </div>
                        </div>
                        <span
                          class="text-xs font-bold text-rose-600 w-14 text-right"
                          >−฿1,200</span
                        >
                      </div>
                    </div>
                    <div class="flex items-center gap-3 px-4 py-3 opacity-50">
                      <div
                        class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center shrink-0"
                      >
                        <svg
                          class="w-3.5 h-3.5 text-emerald-600"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                      </div>
                      <span
                        class="flex-1 text-xs font-semibold text-[#303841] line-through"
                        >นัท</span
                      >
                      <span
                        class="text-xs font-bold text-emerald-600 w-14 text-right"
                        >+฿200</span
                      >
                    </div>
                    <div class="flex items-center gap-3 px-4 py-3">
                      <div
                        class="w-7 h-7 rounded-full bg-[#FFF200]/50 flex items-center justify-center text-[11px] font-bold shrink-0"
                      >
                        ม
                      </div>
                      <span class="flex-1 text-xs font-semibold text-[#303841]"
                        >มิ้น</span
                      >
                      <div class="flex items-center gap-2">
                        <div
                          class="h-1.5 bg-rose-200 rounded-full w-16 overflow-hidden"
                        >
                          <div
                            class="h-full bg-rose-400 rounded-full"
                            style="width:25%"
                          >
                          </div>
                        </div>
                        <span
                          class="text-xs font-bold text-rose-500 w-14 text-right"
                          >−฿150</span
                        >
                      </div>
                    </div>
                  </div>
                </div>

                <!-- net total bar -->
                <div
                  class="bg-[#303841] rounded-xl px-4 py-3.5 flex items-center justify-between"
                >
                  <span class="text-xs font-bold text-white/50"
                    >ยอดสุทธิเดือนนี้</span
                  >
                  <span class="text-lg font-extrabold text-[#FFF200]"
                    >+฿650</span
                  >
                </div>
              </div>
            </div>

            <!-- second floating card -->
            <div
              class="-rotate-[1deg] absolute -bottom-4 -left-4 bg-white rounded-xl border border-[#303841]/10 shadow-xl px-5 py-4 w-52"
            >
              <div class="flex items-center gap-2.5 mb-2">
                <div
                  class="w-6 h-6 rounded-full bg-emerald-500 flex items-center justify-center"
                >
                  <svg
                    class="w-3.5 h-3.5 text-white"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span class="text-xs font-bold text-[#303841]"
                  >เคลียร์แล้ว!</span
                >
              </div>
              <p class="text-[10px] text-[#303841]/45 leading-snug">
                ต้น ยืนยันรับเงิน ฿1,200 เรียบร้อย
              </p>
            </div>
          </div>
        </div>
        <FaqsSection client:load />
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-4 pb-24">
      <div
        class="bg-[#e2f0fa] rounded-[3.5rem] px-12 py-16 flex flex-col lg:flex-row items-center justify-between gap-10 relative overflow-hidden"
      >
        <div
          class="absolute -top-20 -right-20 w-64 h-64 rounded-full border border-white/5 pointer-events-none"
        >
        </div>
        <div
          class="absolute bottom-0 left-1/3 w-40 h-40 rounded-full bg-[#FFF200]/5 blur-2xl pointer-events-none"
        >
        </div>
        <div class="relative z-10">
          <p class="text-[11px] font-bold tracking-[0.14em] uppercase mb-3">
            เริ่มต้นวันนี้
          </p>
          <h2 class="text-4xl font-extrabold leading-tight">
            หยุดปัญหาเรื่องเงิน<br />
            <span class="text-[#FFF200]">ระหว่างเพื่อน</span>
          </h2>
          <p class="text-sm mt-3 max-w-sm leading-relaxed">
            ใช้ฟรี ไม่ต้องใช้บัตรเครดิต
            เพราะมิตรภาพที่ดีไม่ควรมีปัญหาเรื่องเงินคั่นกลาง
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 relative z-10 shrink-0">
          <a
            href="#"
            class="bg-[#FFF200] text-[#303841] font-extrabold text-sm px-8 py-4 rounded-xl hover:bg-yellow-300 transition-colors text-center"
          >
            เริ่มใช้ฟรีเลย
          </a>
          <a
            href="#features"
            class="border border-white/15 text-white/60 font-semibold text-sm px-6 py-4 rounded-xl hover:border-white/30 hover:text-white transition-colors text-center"
          >
            ดูฟีเจอร์ทั้งหมด
          </a>
        </div>
      </div>
    </section>

    <Footer client:load />
  </body>
</html>
