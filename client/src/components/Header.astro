---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import { Button } from "./ui/button";
import { LogoIcon } from "./landing/logo";
---

<header id="site-header" class="fixed inset-x-0 top-5 z-50">
  <div class="mx-auto max-w-5xl px-4">
    <nav
      id="site-nav"
      class="flex items-center justify-between rounded-4xl border transition-all duration-500"
      style="
    padding-top: var(--nav-py, 1rem);
    padding-bottom: var(--nav-py, 1rem);
    padding-left: var(--nav-px, 0px);
    padding-right: var(--nav-px, 0px);
    background: var(--nav-bg, transparent);
    box-shadow: var(--nav-shadow, none);
    border-color: var(--nav-border, transparent);
  "
    >
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 transition-all duration-300">
        <div class="w-8 h-8">
          <LogoIcon />
        </div>
        <div class="flex flex-col leading-none">
          <span class="text-[15px] font-medium tracking-tight text-[#111827]">
            {SITE_TITLE}
          </span>
          <span class="text-[11px] text-muted-foreground">
            Smart payment tracking
          </span>
        </div>
      </a>

      <!-- Nav Links -->
      <div class="hidden items-center gap-1 md:flex">
        <HeaderLink
          href="/"
          class="rounded-xl px-4 py-2 text-sm font-medium text-[#303841]/70 transition-all duration-300 hover:bg-black/[0.04] hover:text-[#111827]"
        >
          หน้าแรก
        </HeaderLink>
        <HeaderLink
          href="/blog"
          class="rounded-xl px-4 py-2 text-sm font-medium text-[#303841]/70 transition-all duration-300 hover:bg-black/[0.04] hover:text-[#111827]"
        >
          วิธีใช้งาน
        </HeaderLink>
        <HeaderLink
          href="/about"
          class="rounded-xl px-4 py-2 text-sm font-medium text-[#303841]/70 transition-all duration-300 hover:bg-black/[0.04] hover:text-[#111827]"
        >
          เกี่ยวกับเรา
        </HeaderLink>
      </div>

      <!-- CTA -->
      <div class="flex items-center gap-2">
        <div id="cta-loading" class="flex items-center gap-2">
          <div class="h-10 w-24 animate-pulse rounded-xl bg-black/[0.06]"></div>
        </div>
        <div id="cta-guest" class="hidden items-center gap-2">
          <Button id="sign-in" size="lg" variant="ghost">เข้าสู่ระบบ</Button>
          <Button id="sign-up" size="lg">เริ่มใช้ฟรี</Button>
        </div>
        <div id="cta-authed" class="hidden items-center gap-2">
          <Button id="go-dashboard" size="lg">แดชบอร์ด</Button>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  import { getCachedUser, getUser } from "@/lib/auth";

  const nav = document.getElementById("site-nav")!;
  const ctaLoading = document.getElementById("cta-loading")!;
  const ctaGuest = document.getElementById("cta-guest")!;
  const ctaAuthed = document.getElementById("cta-authed")!;
  const signInBtn = document.getElementById("sign-in")!;
  const signUpBtn = document.getElementById("sign-up")!;
  const dashboardBtn = document.getElementById("go-dashboard")!;

  // ── Auth state ─────────────────────────────────────────────────────────────

  function showGuest() {
    ctaLoading.classList.add("hidden");
    ctaGuest.classList.remove("hidden");
    ctaGuest.classList.add("flex");
  }

  function showAuthed() {
    ctaLoading.classList.add("hidden");
    ctaAuthed.classList.remove("hidden");
    ctaAuthed.classList.add("flex");
  }

  const cached = getCachedUser();
  if (cached) showAuthed();

  getUser().then((user) => {
    if (cached) return;
    user ? showAuthed() : showGuest();
  });

  signInBtn.addEventListener("click", () => {
    window.location.href = "/auth/sign-in";
  });
  signUpBtn.addEventListener("click", () => {
    window.location.href = "/auth/sign-in";
  });
  dashboardBtn.addEventListener("click", () => {
    window.location.href = "/dashboard";
  });

  // ── Scroll shrink ──────────────────────────────────────────────────────────

  let scrolled = false;

  function onScroll() {
    const isScrolled = window.scrollY > 12;
    if (isScrolled === scrolled) return;
    scrolled = isScrolled;

    if (isScrolled) {
      nav.style.paddingTop = "0.5rem";
      nav.style.paddingBottom = "0.5rem";
      nav.style.paddingLeft = "0.7rem";
      nav.style.paddingRight = "0.7rem";
      nav.style.background = "rgba(255,255,255,0.8)";
      nav.style.boxShadow = "0 8px 40px rgba(0,0,0,0.08)";
      nav.style.borderColor = "rgba(0,0,0,0.05)";
      nav.style.backdropFilter = "blur(20px)";
    } else {
      nav.style.paddingTop = "1rem";
      nav.style.paddingBottom = "1rem";
      nav.style.paddingLeft = "0px";
      nav.style.paddingRight = "0px";
      nav.style.background = "transparent";
      nav.style.boxShadow = "none";
      nav.style.borderColor = "transparent";
      nav.style.backdropFilter = "";
    }
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
